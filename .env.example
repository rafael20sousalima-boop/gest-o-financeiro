# Database
# PostgreSQL connection string for production (Supabase, Neon, Vercel Postgres or other PostgreSQL provider)
# Format: postgresql://user:password@host:port/database

# For Neon (direct connection - recommended for development):
# DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require"

# For Supabase (direct connection - recommended for development):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# For Supabase (pooling mode - recommended for production):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# For Vercel Postgres:
# DATABASE_URL="postgresql://user:password@host:port/database"

# For local development with PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestao_financeira"
