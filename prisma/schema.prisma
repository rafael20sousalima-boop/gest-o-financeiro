generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id            String             @id @default(cuid())
  userId        String
  nome          String
  documento     String?
  telefone      String?
  whatsapp      String?
  endereco      String?
  bairro        String?
  cidade        String?
  observacao    String?
  limiteCredito Float              @default(0)
  status        String             @default("ativo")
  criadoEm      DateTime           @default(now())
  atualizadoEm  DateTime           @updatedAt
  contasReceber ContaReceber[]
  pagamentos    PagamentoReceber[]
  vendas        Venda[]
  user          User               @relation(fields: [userId], references: [id])
}

model Fornecedor {
  id               String       @id @default(cuid())
  userId           String
  nome             String
  documento        String?
  telefone         String?
  whatsapp         String?
  endereco         String?
  produtoFornecido String?
  observacao       String?
  criadoEm         DateTime     @default(now())
  atualizadoEm     DateTime     @updatedAt
  contasPagar      ContaPagar[]
  user             User         @relation(fields: [userId], references: [id])
}

model Produto {
  id            String                @id @default(cuid())
  userId        String
  nome          String
  categoria     String?
  unidade       String                @default("unidade")
  quantidade    Float                 @default(0)
  estoqueMinimo Float                 @default(0)
  custo         Float                 @default(0)
  precoVenda    Float                 @default(0)
  ativo         Boolean               @default(true)
  criadoEm      DateTime              @default(now())
  atualizadoEm  DateTime              @updatedAt
  movimentacoes MovimentacaoEstoque[]
  vendas        Venda[]
  user          User                  @relation(fields: [userId], references: [id])
}

model Venda {
  id              String                @id @default(cuid())
  userId          String
  dataVenda       DateTime              @default(now())
  clienteId       String?
  produtoId       String?
  produtoNome     String
  quantidade      Float                 @default(1)
  unidade         String                @default("unidade")
  pesoKg          Float?
  precoPorKg      Float?
  valorUnitario   Float                 @default(0)
  valorTotal      Float
  tipoPagamento   String
  statusPagamento String                @default("pago")
  dataVencimento  DateTime?
  observacao      String?
  criadoEm        DateTime              @default(now())
  atualizadoEm    DateTime              @updatedAt
  contaReceber    ContaReceber?
  movimentacoes   MovimentacaoEstoque[]
  cliente         Cliente?              @relation(fields: [clienteId], references: [id])
  produto         Produto?              @relation(fields: [produtoId], references: [id])
  user            User                  @relation(fields: [userId], references: [id])
}

model ContaReceber {
  id             String             @id @default(cuid())
  userId         String
  clienteId      String
  vendaId        String?            @unique
  dataVenda      DateTime
  descricao      String
  valorOriginal  Float
  valorRecebido  Float              @default(0)
  saldoRestante  Float
  dataVencimento DateTime?
  status         String             @default("aguardando_pagamento")
  observacao     String?
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt
  cliente        Cliente            @relation(fields: [clienteId], references: [id])
  venda          Venda?             @relation(fields: [vendaId], references: [id])
  pagamentos     PagamentoReceber[]
  user           User               @relation(fields: [userId], references: [id])
}

model PagamentoReceber {
  id             String       @id @default(cuid())
  userId         String
  contaId        String
  clienteId      String?
  valor          Float
  dataPagamento  DateTime     @default(now())
  formaPagamento String
  observacao     String?
  criadoEm       DateTime     @default(now())
  cliente        Cliente?     @relation(fields: [clienteId], references: [id])
  conta          ContaReceber @relation(fields: [contaId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
}

model ContaPagar {
  id             String      @id @default(cuid())
  userId         String
  descricao      String
  categoria      String
  fornecedorId   String?
  dataVencimento DateTime
  valor          Float
  dataPagamento  DateTime?
  formaPagamento String?
  status         String      @default("pendente")
  observacao     String?
  criadoEm       DateTime    @default(now())
  atualizadoEm   DateTime    @updatedAt
  fornecedor     Fornecedor? @relation(fields: [fornecedorId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
}

model MovimentacaoEstoque {
  id         String   @id @default(cuid())
  userId     String
  produtoId  String
  tipo       String
  quantidade Float
  data       DateTime @default(now())
  observacao String?
  vendaId    String?
  criadoEm   DateTime @default(now())
  produto    Produto  @relation(fields: [produtoId], references: [id])
  venda      Venda?   @relation(fields: [vendaId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model MovimentacaoCaixa {
  id         String   @id @default(cuid())
  userId     String
  tipo       String
  categoria  String
  descricao  String
  valor      Float
  data       DateTime @default(now())
  observacao String?
  criadoEm   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Configuracao {
  id           Int    @id @default(1)
  nomeEmpresa  String @default("Minha Empresa")
  saldoInicial Float  @default(0)
}

model User {
  id                  String                @id @default(cuid())
  username            String                @unique
  password            String
  role                String                @default("user")
  nome                String?
  ativo               Boolean               @default(true)
  criadoEm            DateTime              @default(now())
  atualizadoEm        DateTime              @updatedAt
  clientes            Cliente[]
  fornecedores        Fornecedor[]
  produtos            Produto[]
  vendas              Venda[]
  contasReceber       ContaReceber[]
  pagamentosReceber   PagamentoReceber[]
  contasPagar         ContaPagar[]
  movimentacoesEstoque MovimentacaoEstoque[]
  movimentacoesCaixa  MovimentacaoCaixa[]
}
